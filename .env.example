# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app. Used for links inside emails and share cards.
PUBLIC_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
# "pg" uses DATABASE_URL (docker compose up -d gives you one).
# "pglite" runs an embedded Postgres in-process: zero setup, great for a quick start.
DATABASE_DRIVER=pg
DATABASE_URL=postgres://livelog:livelog@localhost:5432/livelog
PGLITE_DATA_DIR=.pglite
# Apply pending migrations automatically on boot (always on for pglite).
AUTO_MIGRATE=false

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Emails listed here become admins when they sign up (comma-separated).
ADMIN_EMAILS=admin@livelog.local

# Used by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL=admin@livelog.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=The Diarist

# ─── Email ───────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to print emails to the server log instead of sending.
# docker compose ships Mailpit: SMTP on 1025, inbox UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Livelog <diary@livelog.local>"
OUTBOX_POLL_MS=5000

# ─── Production ──────────────────────────────────────────────────────────
# Serve the built web app from the API server (single deployable).
SERVE_WEB=false
TRUST_PROXY=false
